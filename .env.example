# ------------------------------------------------------------
# OSINT Dashboard configuration
# Copy this file to ".env" and fill in values. NEVER commit .env
# ------------------------------------------------------------

# REQUIRED for the team-auth branch: use a stable random secret; no default is generated.
# Flask secret (any long random string). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# HTTPS deployments must keep session cookies secure (default true).
# For local HTTP testing only, set SESSION_COOKIE_SECURE=false.
SESSION_COOKIE_SECURE=true

# Live mode performs real lookups against public sources.
# Set to false for a demo-only (offline, fictional data) deployment.
ALLOW_LIVE_MODE=false

# Email breach lookups use XposedOrNot's public API (no configuration key).
# No XposedOrNot environment variable is required. Only query email
# addresses that you own or are authorised to assess in live mode.

# VirusTotal API key (optional).
VIRUSTOTAL_API_KEY=

# AbuseIPDB API key (optional; IP reputation).
ABUSEIPDB_API_KEY=

# Abuse.ch Auth-Key (optional; shared by URLhaus / ThreatFox / MalwareBazaar).
ABUSE_CH_AUTH_KEY=

# Optional: restrict LIVE email checks to domains you own/are authorised for
# (comma separated, e.g. mycollege.edu,mycompany.com). Empty = no restriction
# beyond the authorization checkbox.
AUTHORIZED_EMAIL_DOMAINS=

# Identify your tool honestly to the services you query.
OSINT_USER_AGENT=OSINT-Footprint-Dashboard/1.0 (academic project)

# Timeouts (seconds)
HTTP_TIMEOUT=10
CRTSH_TIMEOUT=25
DNS_TIMEOUT=5

# Rate limit applied to every scan endpoint, per client IP
SCAN_RATE_LIMIT=10 per minute

# Rate limit for pages and read-only API calls, per client IP (static files are exempt)
DEFAULT_RATE_LIMIT=1000 per hour

# Delete stored scans older than this many days (data-retention policy).
# Applied at start-up and every time a scan is saved.
RETENTION_DAYS=30

# Optional: store the SQLite database somewhere else (default: database/osint.db)
# DATABASE_PATH=C:\osint-data\osint.db

# ------------------------------------------------------------
# Phase 2 — optional managed services.
# If omitted, the app still works locally with SQLite and memory rate limits.
# Set these as private Render environment values; NEVER commit credentials.
# DATABASE_URL=postgresql://user:password@hostname:5432/reconlens
# REDIS_URL=redis://hostname:6379/0

# Keep FALSE for local HTTP; set TRUE only behind a trusted proxy (Render).
TRUST_PROXY_HEADERS=false
